# =================================================================
# Enterprise Food Donation Platform - Environment Configuration
# =================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL / SQLite Dual-Mode)
DATABASE_URL=sqlite:///./food_donation.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Distributed Locking (Redis)
REDIS_URL=redis://localhost:6379/0

# 3PL Commercial Dispatch Providers
DOORDASH_API_KEY=test_mock_doordash_key_12345
DOORDASH_DEVELOPER_ID=dev_mock_org
UBER_DIRECT_API_KEY=test_mock_uber_key_67890
UBER_CUSTOMER_ID=cust_mock_org

# Cryptographic & Security Settings
JWT_SECRET=super-secret-jwt-key-for-food-donation-platform
ECDSA_KEY_CURVE=SECP256k1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
TELEMETRY_REFRESH_INTERVAL_SECONDS=20
